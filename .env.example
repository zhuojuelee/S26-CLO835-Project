IMAGE_REPOSITORY_PREFIX=clo835-project
IMAGE_TAG=local

# Browser entrypoint and direct Vite dev server
CLIENT_HOST_PORT=5173
API_PROXY_TARGET=http://main-server:3000

# Main server
MAIN_SERVER_PORT=3000
ORCHESTRATOR_URL=http://task-orchestrator:3001
ADMIN_SECRET=local-admin

# Task orchestrator
TASK_ORCHESTRATOR_PORT=3001
JOB_RUNNER=local

# Local runtime defaults
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_NAME=jobQueue

# Docker socket used by the task orchestrator to spawn local ephemeral-worker containers.
# Docker Desktop for macOS may need: /Users/<you>/.docker/run/docker.sock
DOCKER_SOCKET_HOST_PATH=/var/run/docker.sock
